{
  "name": "ayo-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Ping your teammates from inside Codex and Claude. Local daemon + realtime relay + MCP/hook adapters.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:relay": "pnpm --filter @ayo-dev/relay dev",
    "clean": "pnpm -r exec rm -rf dist .turbo node_modules/.cache",
    "release": "pnpm -r publish --access public"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "node-notifier>uuid": "^11.1.1",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "qs@>=6.7.0 <6.16.1": "^6.16.1",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9"
    }
  }
}
